# Copy to .env and fill in. Never commit real credentials.
# Load with: set -a && source .env && set +a

PIPER_SOURCE_URL=postgres://user:pass@localhost:5432/source_db?sslmode=disable
PIPER_TARGET_URL=mongodb://localhost:27017/target_db

# Optional password override when the URL has no password:
# PIPER_SOURCE_PASSWORD=
# PIPER_TARGET_PASSWORD=
